# ==============================================================================
# Otopazar - Caddyfile (Reverse Proxy Configuration)
# ==============================================================================
# Global Ayarlar
{
    admin off # Dahili yönetim API'sini kapat
}

# ------------------------------------------------------------------------------
# Doğrudan Elastic IP (Port 80 HTTP) ile Erişim
# ------------------------------------------------------------------------------
http://3.123.160.13, :80 {
    # 1. Gzip ve Zstandard ile Anında Sıkıştırma (Performans & Hız)
    encode zstd gzip

    # 2. Güvenlik Başlıkları (Security Headers)
    header {
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    # 3. Yüklenen Medya Dosyaları Boyut Limiti (Maksimum 25MB)
    request_body {
        max_size 25MB
    }

    # 4. Uygulama & WebSocket Reverse Proxy
    # Caddy, WebSocket (Upgrade / Connection) başlıklarını otomatik olarak algılar ve iletir.
    reverse_proxy araba-sitesi-app:8080 {
        transport http {
            read_buffer 8192
        }
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    # 5. Erişim ve Hata Logları
    log {
        output stdout
        format console
        level INFO
    }
}
