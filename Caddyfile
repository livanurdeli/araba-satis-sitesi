# ==============================================================================
# Otopazar - Caddyfile (Modern Reverse Proxy & SSL Configuration)
# ==============================================================================
# Global Ayarlar
{
    admin off # Dahili yönetim API'sini kapat
}

# ------------------------------------------------------------------------------
# Domain (sslip.io ile ücretsiz, gerçek IP'ye çözülen alan adı) + Otomatik HTTPS
# ------------------------------------------------------------------------------
3.123.160.13.sslip.io {
    # 1. Gzip ve Zstandard ile Anında Sıkıştırma (Performans & Hız)
    encode zstd gzip

    # 2. Güvenlik Başlıkları (Security Headers)
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    # 3. Yüklenen Medya Dosyaları Boyut Limiti (Maksimum 25MB)
    request_body {
        max_size 25MB
    }

    # 4. Uygulama & WebSocket Reverse Proxy
    # Caddy, WebSocket (Upgrade / Connection) başlıklarını otomatik olarak algılar ve iletir.
    reverse_proxy araba-sitesi-app:8080 {
        transport http {
            read_buffer 8192
        }
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    # 5. Erişim ve Hata Logları
    log {
        output stdout
        format console
        level INFO
    }
}

# ------------------------------------------------------------------------------
# Sadece çıplak IP ile gelen (domain kullanmayan) istekleri sslip.io'ya yönlendir
# ------------------------------------------------------------------------------
http://3.123.160.13 {
    redir https://3.123.160.13.sslip.io{uri} permanent
}
